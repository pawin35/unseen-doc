# Copy to .env and fill in real values.

# SQLite now; for Postgres later change provider in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/flowclone"
DATABASE_URL="file:./data/app.db"

# Where uploads (logo/signature) and the SQLite DB live. Docker mounts a volume here.
DATA_DIR="./data"

# Admin credential for the single login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# 32+ char random secret for the session cookie (e.g. `openssl rand -base64 32`).
SESSION_SECRET="change-me-to-a-long-random-string-32+"

# Keep Bangkok time for document numbering and printed dates.
TZ="Asia/Bangkok"
